@dataclass
class AgentConfig:
    agent_id: str
    name: str
    role: str
    version: str
    description: str
    system_prompt: str
    raw_config: dict = field(default_factory=dict)
    loaded_at: datetime = field(default_factory=datetime.now)

@dataclass
class Task:
    task_id: str
    title: str
    assigned_agent: str
    input_data: dict
    output_data: str = ""
    status: str = "PENDING"  # PENDING, IN_PROGRESS, COMPLETED, FAILED
    created_at: str = field(default_factory=lambda: datetime.now().isoformat())
    completed_at: str = ""

@dataclass
class MediaPayload:
    title: str
    description: str
    tags: list[str]
    script_hooks: list[str]
    rendered_file: str
    platforms: list[str]  # ['youtube', 'tiktok']
    scheduled_time: str = ""

@dataclass
class TransactionRecord:
    transaction_id: str
    client_name: str
    amount: float
    currency: str
    status: str  # VERIFIED, PENDING, REJECTED
    payment_date: str

