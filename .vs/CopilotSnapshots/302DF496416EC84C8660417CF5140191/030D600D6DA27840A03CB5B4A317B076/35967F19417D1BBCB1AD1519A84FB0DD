class GasparAgentManager:
    """GERENTE DE AGENTES IA: Crear, Supervisar, Balancear y Ejecutar Agentes de IA"""
    def __init__(self, loader: AgentPackageLoader, logger: JohnMarstonCore, 
                 yt_conn: YouTubeConnector, tt_conn: TikTokConnector,
                 fb_conn: FacebookConnector = None, ig_conn: InstagramConnector = None):
        self.loader = loader
        self.logger = logger
        self.yt_conn = yt_conn
        self.tt_conn = tt_conn
        self.fb_conn = fb_conn
        self.ig_conn = ig_conn

        # Diccionario de conectores por plataforma
        self.connectors = {
            "youtube": self.yt_conn,
            "tiktok": self.tt_conn,
            "facebook": self.fb_conn,
            "instagram": self.ig_conn
        }

    def dispatch_agent_task(self, role: str, task_context: dict) -> dict:
        agent = self.loader.loaded_agents.get(role.lower())
        agent_name = agent.name if agent else f"Agente_{role.capitalize()}"

        self.logger.log_event("GASPAR", f"Invocando agente de Artok Studio: [{agent_name}] para rol [{role.upper()}]")
        
        topic = task_context.get("topic", "Contenido General ARTOK")
        cta_invitation = "\n\n👉 ¡Si te gustó este contenido, no olvides suscribirte y activar las notificaciones para ver más videos exclusivos de Artok IA Viral Studio!"

        if role == "director":
            return {
                "decision": "Estrategia de contenido aprobada para YouTube Shorts y TikTok.",
                "viral_angle": f"Enfoque de alto rendimiento para '{topic}'",
                "target_platforms": ["youtube", "tiktok"]
            }
        elif role == "productor":
            return {
                "script_title": f"🚀 Innovación con {topic}",
                "hooks": [
                    "¿Sabías que esto cambia todo por completo?",
                    "Atento a los primeros 3 segundos...",
                    "Aplica este truco hoy mismo."
                ],
                "visual_cues": "Cortes dinámicos cada 1.5s y subtítulos animados en amarillo/blanco."
            }
        elif role == "editor":
            return {
                "rendered_file": f"exports/artok_render_{uuid.uuid4().hex[:6]}.mp4",
                "aspect_ratio": "9:16",
                "resolution": "1080x1920",
                "audio_track": "Artok_Official_Beat.mp3"
            }
        elif role == "publisher":
            title = f"🚀 Revolución con {topic} | ARTOK IA Studio"
            description = f"Aprende cómo optimizar tu flujo de trabajo con {topic}.{cta_invitation}"
            tags = ["AI", "Automation", "ArtokStudio", "TechViral", "Shorts"]
            
            return {
                "title": title,
                "description": description,
                "tags": tags,
                "prepared_payload": True
            }
        elif role == "scheduler":
            # CORREGIDO: Validación de datos previos antes de acceder
            results = task_context.get("results", {})
            
            # Verificar que existen los datos previos requeridos
            if "publisher" not in results:
                self.logger.log_event("GASPAR", "[!] Error: No se encontraron resultados del publisher.")
                return {"status": "ERROR", "message": "Datos del publisher no disponibles"}
            
            # Obtener datos de manera segura con .get()
            pub_data = results.get("publisher", {})
            prod_data = results.get("productor", {})
            editor_data = results.get("editor", {})
            dir_data = results.get("director", {})
            
            # Configuración de 3 videos, 3 veces al día (9:00 AM, 3:00 PM, 8:00 PM - Lunes a Viernes)
            daily_slots = ["09:00 AM", "03:00 PM", "08:00 PM"]
            
            payload = MediaPayload(
                title=pub_data.get("title", "Sin título"),
                description=pub_data.get("description", ""),
                tags=pub_data.get("tags", []),
                script_hooks=prod_data.get("hooks", []),
                rendered_file=editor_data.get("rendered_file", ""),
                platforms=dir_data.get("target_platforms", ["youtube"]),
                scheduled_time=datetime.now().strftime("%Y-%m-%d %H:%M:%S")
            )

            pub_results = {}
            if "youtube" in payload.platforms:
                pub_results["youtube"] = self.yt_conn.publish_video(payload)
            if "tiktok" in payload.platforms:
                pub_results["tiktok"] = self.tt_conn.publish_video(payload)
            if "facebook" in payload.platforms:
                pub_results["facebook"] = self.fb_conn.publish_media(payload) if self.fb_conn else {"status": "SKIPPED", "message": "Conector de Facebook no disponible"}
            if "instagram" in payload.platforms:
                pub_results["instagram"] = self.ig_conn.publish_media(payload) if self.ig_conn else {"status": "SKIPPED", "message": "Conector de Instagram no disponible"}

            return {
                "schedule_status": "PROGRAMADO_Y_PUBLICADO",
                "daily_slots": daily_slots,
                "schedule_frequency": "3 videos / 3 veces al día (9:00 AM, 3:00 PM, 8:00 PM - Lunes a Viernes)",
                "dispatch_details": pub_results
            }
        else:
            return {"status": f"Procesamiento finalizado por agente {agent_name}."}

