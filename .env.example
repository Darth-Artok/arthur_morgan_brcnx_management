# =====================================================================
# ARCHIVO DE CONFIGURACIÓN DE CREDENCIALES PARA APIs SOCIALES
# =====================================================================
# 
# INSTRUCCIONES:
# 1. Copia este archivo como ".env" en la raíz del proyecto
# 2. Reemplaza los valores con tus credenciales reales
# 3. NUNCA hagas commit de .env a tu repositorio (debe estar en .gitignore)
# 4. Para modo local/simulado, simplemente omite las variables o déjalas vacías
#
# =====================================================================

# MODO DE OPERACIÓN
# USE_EXTERNAL_APIS = False  # Desactiva APIs externas, mode simulado
# USE_EXTERNAL_APIS = True   # Activa APIs externas, requiere credenciales válidas
USE_EXTERNAL_APIS=False
MANUAL_BILLING=True

# =====================================================================
# YOUTUBE DATA API v3
# Obtener credenciales en: https://console.cloud.google.com/
# =====================================================================
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# =====================================================================
# TIKTOK BUSINESS API
# Obtener credenciales en: https://developers.tiktok.com/
# Documentación: https://developers.tiktok.com/doc/tiktok-api-overview
# =====================================================================
TIKTOK_CLIENT_KEY=tu_tiktok_client_key_aqui
TIKTOK_CLIENT_SECRET=tu_tiktok_client_secret_aqui
TIKTOK_ACCESS_TOKEN=tu_tiktok_access_token_aqui

# =====================================================================
# FACEBOOK GRAPH API v18.0+
# Obtener credenciales en: https://developers.facebook.com/
# Documentación: https://developers.facebook.com/docs/graph-api/
# =====================================================================
FACEBOOK_PAGE_ID=tu_facebook_page_id_aqui
FACEBOOK_ACCESS_TOKEN=tu_facebook_access_token_aqui
FACEBOOK_APP_ID=tu_facebook_app_id_aqui
FACEBOOK_APP_SECRET=tu_facebook_app_secret_aqui

# =====================================================================
# INSTAGRAM GRAPH API v18.0+
# Obtener credenciales en: https://developers.instagram.com/
# Documentación: https://developers.instagram.com/docs/instagram-graph-api
# Nota: Requiere cuenta con Business Account vinculada a Facebook
# =====================================================================
INSTAGRAM_BUSINESS_ACCOUNT_ID=tu_instagram_business_account_id_aqui
INSTAGRAM_ACCESS_TOKEN=tu_instagram_access_token_aqui
INSTAGRAM_APP_ID=tu_instagram_app_id_aqui
INSTAGRAM_APP_SECRET=tu_instagram_app_secret_aqui

# =====================================================================
# OTRAS CONFIGURACIONES (OPCIONAL)
# =====================================================================
LOG_LEVEL=INFO
ENVIRONMENT=development
